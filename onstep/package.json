{
  "name": "OnStep",
  "version": "1.0.0",
  "description": "OnStep Desktop UI",
  "main": "js/server.js",
  "type": "module",
  "imports": {
    "#server/*": "./js/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "webpack": "npx webpack --config config/webpack.js",
    "beautify": "find js/ -type f -name \"*.js\" -exec npx js-beautify -r {} \\;",
    "testbeautify": "find tests/ -type f -name \"*.js\" -exec npx js-beautify -r {} \\;",
    "jsxbeautify": "find js/ -type f -name \"*.jsx\" -exec npx js-beautify -X -r {} \\;"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.22.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@swc/core": "1.15.40",
    "css-loader": "7.1.2",
    "electron": "41.10.3",
    "js-beautify": "1.15.4",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "webpack": "^5.107.2",
    "webpack-cli": "6.0.1"
  }
}
